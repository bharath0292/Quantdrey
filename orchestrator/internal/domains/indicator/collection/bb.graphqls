################### Bollinger Band ####################
enum BbOutput {
    upper
    middler
    lower
}

type BbParams {
    period: Int!
    stddev: Int!
    output: BbOutput!
}

input CreateBbParams {
    period: Int!
    stddev: Int!
    output: BbOutput!
}

input UpdateBbParams {
    period: Int
    stddev: Int
    output: BbOutput
}

type Bb {
    upper: Float!
    middle: Float!
    lower: Float!
}
